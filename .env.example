# --- AWS / Bedrock (live profile) -------------------------------------
# The blueprint leads with the real provider: Amazon Bedrock AgentCore.
# With an AWS account wired, the Runtime entrypoint is the
# bedrock-agentcore SDK's BedrockAgentCoreApp and the model profile
# below selects a Bedrock-hosted model.
AWS_REGION=us-east-1
AWS_PROFILE=
# The model gateway profile (R12): offline | bedrock | nim.
# offline is the deterministic default; the hosted profiles are
# fail-closed until a deployment binds their transport.
RETURNS_MODEL_PROFILE=offline
# Model id for the bedrock profile (Bedrock Converse-shaped).
RETURNS_BEDROCK_MODEL_ID=
# Model id for the nim profile (NVIDIA NIM, chat-completions-shaped).
RETURNS_NIM_MODEL_ID=
# Inference-profile ARN of the Bedrock model used when
# RETURNS_MODEL_PROFILE=hosted-bedrock (pin an ARN, not a family name).
RETURNS_BEDROCK_MODEL_ARN=

# --- Store -------------------------------------------------------------
# SQLite is the local default. Set DATABASE_URL to use Postgres.
RETURNS_SQLITE_PATH=./data/returns.db
DATABASE_URL=
# postgresql://returns:returns@localhost:5432/returns

# --- Evidence store (S3-shaped port; local double by default) ---------
RETURNS_EVIDENCE_DIR=./data/evidence
RETURNS_EVIDENCE_BUCKET=returns-evidence
